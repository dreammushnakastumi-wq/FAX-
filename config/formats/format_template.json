{
  "format_name": "テンプレート",
  "description": "フォーマット定義のテンプレート",
  "patterns": {
    "date": "日付.*?(\\d{4}[年/]\\d{1,2}[月/]\\d{1,2}[日])",
    "order_number": "発注[№番号]*[：:]\\s*([^\\n]+)",
    "customer": "得意先[：:]\\s*([^\\n]+)",
    "delivery": "納品先[：:]\\s*([^\\n]+)",
    "delivery_date": "納品日[：:]\\s*(\\d{4}[年/]\\d{1,2}[月/]\\d{1,2}[日])",
    "items": "品名.*?数量.*?単価.*?金額"
  },
  "item_extraction": {
    "product_name": "品名[：:]\\s*([^\\n]+)",
    "quantity": "数量[：:]\\s*([\\d,]+)",
    "unit_price": "単価[：:]\\s*([\\d,]+)",
    "amount": "金額[：:]\\s*([\\d,]+)"
  }
}
