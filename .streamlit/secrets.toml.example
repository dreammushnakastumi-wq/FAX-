# Streamlit Secrets設定テンプレート
# 
# 【使用方法】
# 1. このファイルをコピーして secrets.toml を作成してください
# 2. 各項目に実際の値を設定してください
# 3. Streamlit Cloudを使用する場合は、ダッシュボードで直接設定することもできます
#
# 【重要】
# - secrets.toml は機密情報を含むため、Gitにコミットしないでください
# - .gitignore で除外されています

# ========================================
# Google Sheets設定
# ========================================
# GoogleスプレッドシートのIDを設定してください
# スプレッドシートのURLから取得できます:
# 例: https://docs.google.com/spreadsheets/d/【ここがID】/edit
GOOGLE_SHEETS_ID = "あなたのスプレッドシートID"

# ========================================
# Google Document AI設定
# ========================================
# Google Cloud Platformでプロジェクトを作成し、Document AI APIを有効化してください
# 詳細: https://cloud.google.com/document-ai/docs

# Google Cloud プロジェクトID
DOCUMENT_AI_PROJECT_ID = "あなたのプロジェクトID"

# Document AIプロセッサーID
# Document AIコンソールでプロセッサーを作成した際に発行されるID
DOCUMENT_AI_PROCESSOR_ID = "あなたのプロセッサーID"

# プロセッサーのロケーション（通常は asia-northeast1）
DOCUMENT_AI_LOCATION = "asia-northeast1"

# ========================================
# サービスアカウントキー
# ========================================
# Google Cloud Consoleでサービスアカウントを作成し、JSONキーをダウンロードしてください
# 1. Google Cloud Console > IAMと管理 > サービスアカウント
# 2. サービスアカウントを作成
# 3. キー > キーを追加 > JSONを作成
# 4. ダウンロードしたJSONファイルの内容を文字列として設定
#
# 【注意】
# - 改行を含むJSON文字列の場合は、三重引用符（"""）を使用してください
# - Streamlit Cloudの場合は、JSON全体を1行の文字列として設定することもできます
SERVICE_ACCOUNT_KEY = """
{
  "type": "service_account",
  "project_id": "your-project-id",
  "private_key_id": "your-private-key-id",
  "private_key": "-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n",
  "client_email": "your-service-account@your-project.iam.gserviceaccount.com",
  "client_id": "your-client-id",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project.iam.gserviceaccount.com"
}
"""

# ========================================
# AI API設定
# ========================================
# Claude APIまたはOpenAI APIのいずれかを使用できます

# 使用するAI APIタイプ（"claude" または "openai"）
AI_API_TYPE = "claude"

# Claude APIキー（Anthropicから取得）
# 取得方法: https://console.anthropic.com/
ANTHROPIC_API_KEY = "あなたのClaude APIキー"

# OpenAI APIキー（オプション、AI_API_TYPEが"openai"の場合に必要）
# 取得方法: https://platform.openai.com/api-keys
OPENAI_API_KEY = "あなたのOpenAI APIキー（オプション）"

# ========================================
# ローカル実行とStreamlit Cloudの違い
# ========================================
# 
# 【ローカル実行の場合】
# - このファイルを .streamlit/secrets.toml として保存
# - 実際の値を設定
# - run.bat（Windows）または run.sh（Mac/Linux）で起動
#
# 【Streamlit Cloudの場合】
# - GitHubリポジトリにプッシュ
# - Streamlit Cloudダッシュボード > Settings > Secrets
# - このファイルの内容をそのまま貼り付け（実際の値に置き換え）
# - 自動的にデプロイされる
